# ==============================================================================
# 🎯 GLITCHHUNTER AI - VARIABLES DE ENTORNO (CONFIGURACIÓN)
# ==============================================================================
# Copia este archivo a '.env' para personalizar tu entorno:
# cp .env.example .env

# --- Modo de Operación de Scrapers ---
# true: Monitorea catálogos y tiendas reales en vivo de Chile con stock activo
# false: Usa el catálogo de simulación local (benchmark para pruebas matemáticas)
USE_LIVE_SCRAPING=true

# Intervalo del Revisor Continuo en segundo plano (en segundos)
# 60 = cada 1 minuto (recomendado para detectar bugs antes de que los corrijan)
SCAN_INTERVAL_SECONDS=60
AUTO_SCAN_ENABLED=true

# --- Notificaciones Push Móviles Instantáneas vía ntfy.sh ---
# ntfy te permite recibir alertas directas en tu celular Android / iPhone
# Abre automáticamente el link oficial de la tienda al presionar la notificación
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
# ⚠️ Los topics de ntfy.sh son PÚBLICOS: usa un nombre largo y aleatorio (sin topic, ntfy queda desactivado)
# Genera uno con: python3 -c "import secrets; print('glitchhunter_' + secrets.token_urlsafe(16))"
NTFY_TOPIC=

# --- Despacho a Canal o Grupo de Telegram ---
# Si TELEGRAM_SIMULATION_MODE=true, simula los mensajes en la consola con formato Rich
# Si es false, requiere un bot_token real de @BotFather
TELEGRAM_SIMULATION_MODE=true
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=@glitchhunter_chile_alerts

# --- Servidor Web & Radar en Tiempo Real ---
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Clave para endpoints administrativos (/api/scan, /api/test-glitch, /api/watchlist).
# Vacía = sin autenticación (solo recomendable en uso local).
API_AUTH_KEY=

# Orígenes CORS permitidos (separados por coma). Por defecto solo el propio dashboard.
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
