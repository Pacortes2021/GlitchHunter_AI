# ==============================================================================
# 🎯 GLITCHHUNTER AI - VARIABLES DE ENTORNO (CONFIGURACIÓN)
# ==============================================================================
# Copia este archivo a '.env' para personalizar tu entorno:
# cp .env.example .env

# --- Modo de Operación de Scrapers ---
# true: Monitorea catálogos y tiendas reales en vivo de Chile con stock activo
# false: Usa el catálogo de simulación local (benchmark para pruebas matemáticas)
USE_LIVE_SCRAPING=true

# Intervalo del Revisor Continuo en segundo plano (en segundos)
# 60 = cada 1 minuto (recomendado para detectar bugs antes de que los corrijan)
# Los agregadores (SoloTodo/Knasta) actualizan cada ~40 min: 300s (5 min) es suficiente
SCAN_INTERVAL_SECONDS=300
AUTO_SCAN_ENABLED=true

# --- Modo Híbrido: Lectura Directa de Falabella y Ripley ---
# Confirma en la tienda (precio en tiempo real) cada candidato detectado vía agregador antes de alertar
DIRECT_CONFIRM_ENABLED=true
# Escaneo directo frecuente de tu watchlist (y de las categorías indicadas) en Falabella y Ripley
DIRECT_SCAN_ENABLED=true
DIRECT_SCAN_INTERVAL_SECONDS=180
# Categorías opcionales separadas por coma. Cada página pesa ~1-2,5 MB: usa pocas.
# Falabella: tecnologia, smartphones, notebooks, consolas, televisores | Ripley: smartphones, notebooks, televisores, consolas
# Sodimac: televisores, linea_blanca, lavadoras, herramientas
# Paris: smartphones, notebooks, televisores, consolas, linea_blanca (~30 productos por página)
# Ej: smartphones,notebooks,televisores,consolas = 8 páginas (~2,4 MB comprimidos) por ciclo, ~1,1 GB/día cada 3 min
DIRECT_SCAN_CATEGORIES=
# PC Factory: su catálogo completo (~63 páginas de 48 productos, ~35 KB c/u) se recorre por tramos.
# Con 10 páginas por ciclo de 3 min, una vuelta completa toma ~20 min.
DIRECT_PCFACTORY_PAGES_PER_CYCLE=10

# Reparto de tiendas entre dos radares (servidor en la nube + PC de la casa).
# Algunas tiendas (Ripley, Paris, Sodimac…) bloquean las IPs de centros de datos:
# en el servidor ponlas en RADAR_SKIP_STORES y en el PC de la casa en RADAR_ONLY_STORES.
# "shopify" equivale a todas las tiendas Shopify. Vacío = todas las tiendas.
# Productos que casi nunca bajan 40% (Apple) y las palabras de tu watchlist: el canal los publica
# desde DEAL_PRIORITY_MIN_DISCOUNT (sin accesorios "para iPhone" ni reacondicionados).
DEAL_PRIORITY_KEYWORDS=iphone,macbook,ipad,airpods,apple watch,imac,mac mini,mac studio,homepod,apple tv
DEAL_PRIORITY_MIN_DISCOUNT=15
RADAR_ONLY_STORES=
RADAR_SKIP_STORES=
# Unir paneles: el PC de la casa envía lo que lee al servidor, que lo procesa y lo publica en su canal.
# En el PC: FORWARD_TO_URL apunta al servidor (por túnel SSH, ver deploy/GUIA_ORACLE_CLOUD.md)
# y FORWARD_API_KEY es la API_AUTH_KEY del servidor. Vacío = no se envía nada.
FORWARD_TO_URL=
FORWARD_API_KEY=

# --- Modo Evento (CyberDay, Cyber Monday, Black Friday, Navidad) ---
# La mayoría de los errores de precio en Chile ocurre en estos eventos y dura de minutos a 2 h.
# Durante las fechas indicadas, la lectura directa pasa a EVENT_DIRECT_SCAN_INTERVAL_SECONDS.
# Formato: Nombre=AAAA-MM-DD:AAAA-MM-DD separados por coma (hora de Chile, fechas inclusive).
EVENT_MODE=auto
EVENT_WINDOWS=Black Friday=2026-11-26:2026-12-01,Navidad=2026-12-18:2026-12-24
EVENT_DIRECT_SCAN_INTERVAL_SECONDS=60

# --- Notificaciones Push Móviles Instantáneas vía ntfy.sh ---
# ntfy te permite recibir alertas directas en tu celular Android / iPhone
# Abre automáticamente el link oficial de la tienda al presionar la notificación
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
# ⚠️ Los topics de ntfy.sh son PÚBLICOS: usa un nombre largo y aleatorio (sin topic, ntfy queda desactivado)
# Genera uno con: python3 -c "import secrets; print('glitchhunter_' + secrets.token_urlsafe(16))"
NTFY_TOPIC=

# --- Despacho a Canal o Grupo de Telegram ---
# Si TELEGRAM_SIMULATION_MODE=true, simula los mensajes en la consola con formato Rich
# Si es false, requiere un bot_token real de @BotFather
TELEGRAM_SIMULATION_MODE=true
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=@glitchhunter_chile_alerts

# --- Servidor Web & Radar en Tiempo Real ---
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Clave para endpoints administrativos (/api/scan, /api/test-glitch, /api/watchlist).
# Vacía = sin autenticación (solo recomendable en uso local).
API_AUTH_KEY=

# Orígenes CORS permitidos (separados por coma). Por defecto solo el propio dashboard.
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
